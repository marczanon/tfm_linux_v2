# Plantilla de entorno para Fase 6.
# No incluir secretos ni tokens en este fichero.

# Puertos publicados en el host. Dentro de los contenedores, backend escucha en
# 8010 y frontend en 5173.
TFM_API_PORT=8010
TFM_FRONTEND_PORT=5173

# Hosts internos previstos para contenedores.
TFM_API_HOST=0.0.0.0
TFM_FRONTEND_HOST=0.0.0.0

# Frontend.
# En navegador, la app usa /api para hablar con el backend mediante proxy.
VITE_API_BASE_URL=/api
# En Vite dev dentro de Docker, el proxy debera apuntar al servicio backend.
VITE_DEV_PROXY_TARGET=http://backend:8010

# Ollama queda externo al primer compose.
# En Linux se anadira host.docker.internal con host-gateway en docker-compose.
TFM_LLM_PROVIDER=ollama
TFM_LLM_MODEL=qwen3.5:4b
OLLAMA_HOST=http://host.docker.internal:11434
TFM_LLM_TIMEOUT_SECONDS=60
TFM_LLM_THINK=false

# Embeddings de memoria agentica.
TFM_EMBEDDING_PROVIDER=ollama
TFM_EMBEDDING_MODEL=qwen3-embedding:0.6b
TFM_EMBEDDING_TIMEOUT_SECONDS=60
# Solo se usa si TFM_EMBEDDING_PROVIDER=local_hash.
TFM_EMBEDDING_DIMENSION=128

# Bind mounts previstos. Las imagenes no deben contener datos ni artefactos.
TFM_HOST_DATA_DIR=../data
TFM_HOST_REPORTS_DIR=../reports
TFM_HOST_MODELS_DIR=../models
TFM_HOST_EXPERIMENTS_DIR=../experiments
